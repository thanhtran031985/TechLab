{
  "version": 4,
  "meta": {
    "name": "TechLab",
    "style": "Fluent Compact + Master–Detail",
    "note": "Dày dữ liệu, không cuộn cả trang ở >=1366x768. Mặt sáng mặc định, hỗ trợ Dark Mode qua [data-theme=\"dark\"], viền mảnh, thanh bên sáng, xanh Fluent."
  },
  "font": {
    "ui": "\"Segoe UI\", \"Segoe UI Web\", Roboto, Arial, sans-serif",
    "mono": "Consolas, \"Cascadia Mono\", ui-monospace, monospace"
  },
  "color": {
    "bg": {
      "light": "#F5F5F5",
      "dark": "#1F1F1F",
      "use": "Nền vùng nội dung."
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#292929",
      "use": "Mặt panel, bảng, ô nhập, thanh trên, ngăn kéo."
    },
    "surface-2": {
      "light": "#FAFAFA",
      "dark": "#2E2E2E",
      "use": "Tiêu đề bảng, hover dòng, panel Inspector, khối phụ."
    },
    "line": {
      "light": "#E0E0E0",
      "dark": "#3D3D3D",
      "use": "Viền panel, chia dòng bảng."
    },
    "line-strong": {
      "light": "#707070",
      "dark": "#959595",
      "use": "Viền dưới ô nhập, nút phụ (>= 4.5:1)."
    },
    "ink": {
      "light": "#242424",
      "dark": "#F0F0F0",
      "use": "Chữ chính."
    },
    "ink-soft": {
      "light": "#616161",
      "dark": "#ADADAD",
      "use": "Chữ phụ, nhãn cột, mốc thời gian."
    },
    "primary": {
      "light": "#0F6CBD",
      "dark": "#479EF5",
      "use": "Nút chính, link, bước/tab đang chọn."
    },
    "primary-hover": {
      "light": "#115EA3",
      "dark": "#62ABF5",
      "use": "Hover nút chính."
    },
    "on-primary": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A",
      "use": "Chữ trên primary."
    },
    "primary-soft": {
      "light": "#EBF3FC",
      "dark": "#0F2C48",
      "use": "Nền mục/bước/dòng đang chọn, chip phương thức GET."
    },
    "focus": {
      "light": "#0F6CBD",
      "dark": "#62ABF5",
      "use": "Viền focus 2px."
    },
    "nav-bg": {
      "light": "#FFFFFF",
      "dark": "#292929",
      "use": "Nền thanh bên (Fluent: sáng, viền phải)."
    },
    "nav-ink": {
      "light": "#242424",
      "dark": "#F0F0F0",
      "use": "Chữ menu."
    },
    "nav-active": {
      "light": "#EBF3FC",
      "dark": "#0F2C48",
      "use": "Mục menu đang chọn."
    },
    "nav-accent": {
      "light": "#0F6CBD",
      "dark": "#479EF5",
      "use": "Vạch trái mục đang chọn."
    },
    "ok": {
      "light": "#107C10",
      "dark": "#54B054",
      "use": "Senior Mode, Challenge đạt, HTTP 2xx."
    },
    "ok-soft": {
      "light": "#F1FAF1",
      "dark": "#0D2E0D",
      "use": "Nền chip ok."
    },
    "crit": {
      "light": "#C50F1F",
      "dark": "#F1707B",
      "use": "Lỗi mô phỏng, HTTP 4xx/5xx, DELETE, cảnh báo bảo mật."
    },
    "crit-soft": {
      "light": "#FDF3F4",
      "dark": "#3B1418",
      "use": "Nền lỗi, cảnh báo lỗ hổng."
    },
    "warn": {
      "light": "#BC4B09",
      "dark": "#F7A46B",
      "use": "Junior (First-Try) Mode, PUT/PATCH, cảnh báo hiệu năng."
    },
    "warn-soft": {
      "light": "#FFF9F5",
      "dark": "#3A2210",
      "use": "Nền cảnh báo Junior."
    },
    "purple": {
      "light": "#5C2E91",
      "dark": "#C4B5FD",
      "use": "GraphQL, gRPC, thẻ nâng cao."
    },
    "purple-soft": {
      "light": "#F7F4FB",
      "dark": "#2A1F4D",
      "use": "Nền chip purple."
    },
    "off": {
      "light": "#616161",
      "dark": "#ADADAD",
      "use": "Chưa bắt đầu, đã khai tử (Deprecated)."
    },
    "off-soft": {
      "light": "#F0F0F0",
      "dark": "#333333",
      "use": "Nền chip off."
    },
    "info": {
      "light": "#0F6CBD",
      "dark": "#62ABF5",
      "use": "Đang học, thông tin gói tin, HTTP 1xx/3xx."
    },
    "info-soft": {
      "light": "#EBF3FC",
      "dark": "#0F2C48",
      "use": "Nền thông tin."
    },
    "code-bg": {
      "light": "#1E1E1E",
      "dark": "#141414",
      "use": "Nền khối mã, Raw HTTP Inspector."
    },
    "code-ink": {
      "light": "#D4D4D4",
      "dark": "#D4D4D4",
      "use": "Chữ khối mã, Raw HTTP Inspector."
    }
  },
  "type": {
    "screen-title": {
      "size": 18,
      "line": 1.3,
      "weight": 600,
      "use": "Tiêu đề màn (một dòng, cùng hàng mô tả)."
    },
    "section-title": {
      "size": 14,
      "line": 1.4,
      "weight": 600,
      "use": "Tiêu đề khối/panel."
    },
    "kpi-figure": {
      "size": 20,
      "line": 1.2,
      "weight": 600,
      "use": "Số liệu tiến độ / thống kê."
    },
    "body": {
      "size": 13,
      "line": 1.45,
      "weight": 400,
      "use": "Chữ mặc định."
    },
    "body-sm": {
      "size": 12,
      "line": 1.4,
      "weight": 400,
      "use": "Gợi ý, mô tả, ô phụ."
    },
    "label": {
      "size": 12,
      "line": 1.4,
      "weight": 600,
      "use": "Nhãn ô nhập, tiêu đề cột."
    },
    "button": {
      "size": 13,
      "line": 1.2,
      "weight": 600,
      "use": "Chữ nút."
    },
    "chip": {
      "size": 11,
      "line": 1.4,
      "weight": 600,
      "use": "Chip trạng thái, HTTP Method."
    },
    "caption": {
      "size": 11,
      "line": 1.4,
      "weight": 600,
      "use": "Nhãn nhóm menu."
    },
    "code": {
      "size": 12,
      "line": 1.5,
      "weight": 400,
      "use": "Mã, URL, JSON, HTTP Header, SQL."
    }
  },
  "space": {
    "space-2": 2,
    "space-4": 4,
    "space-6": 6,
    "space-8": 8,
    "space-10": 10,
    "space-12": 12,
    "space-14": 14,
    "space-16": 16,
    "space-18": 18,
    "space-20": 20,
    "space-24": 24,
    "space-28": 28,
    "space-32": 32
  },
  "radius": {
    "radius-chip": 4,
    "radius-control": 4,
    "radius-card": 6,
    "radius-step": 4,
    "radius-pill": 999
  },
  "shadow": {
    "shadow-card": {
      "light": "0 1px 2px rgba(0,0,0,.12)",
      "dark": "0 1px 2px rgba(0,0,0,.4)"
    },
    "shadow-popover": {
      "light": "0 4px 16px rgba(0,0,0,.14)",
      "dark": "0 4px 16px rgba(0,0,0,.5)"
    },
    "shadow-drawer": {
      "light": "-4px 0 24px rgba(0,0,0,.14)",
      "dark": "-4px 0 24px rgba(0,0,0,.55)"
    }
  },
  "size": {
    "size-nav": 200,
    "size-nav-collapsed": 48,
    "size-header": 44,
    "size-control": 30,
    "size-control-sm": 26,
    "size-drawer": 480,
    "size-detail-panel": 320,
    "size-commandbar": 40,
    "size-stepper": 34,
    "size-grid-row": 32,
    "size-grid-header": 30,
    "size-list-row": 40
  },
  "size_use": {
    "size-detail-panel": "Panel thuộc tính / chi tiết bên phải (master–detail).",
    "size-commandbar": "Thanh lệnh trên Lab / danh sách.",
    "size-stepper": "Hàng thanh tiến trình bước mạng / mô phỏng.",
    "size-grid-row": "Chiều cao dòng bảng dữ liệu.",
    "size-grid-header": "Chiều cao tiêu đề bảng dữ liệu.",
    "size-list-row": "Dòng danh sách khóa học / module."
  },
  "status": {
    "PASSED": ["ok", "Đạt", "check"],
    "FAILED": ["crit", "Chưa đạt", "x-circle"],
    "JUNIOR_BUG": ["warn", "Lỗi Junior", "alert-triangle"],
    "SENIOR_OK": ["ok", "Chuẩn Senior", "shield-check"],
    "IN_PROGRESS": ["info", "Đang học", "clock"],
    "NOT_STARTED": ["off", "Chưa bắt đầu", "circle"]
  }
}
